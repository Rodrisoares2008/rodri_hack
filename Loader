local function setStatus(text, color)
	statusLbl.Visible = true
	statusLbl.Text = text
	statusLbl.TextColor3 = color or C.Accent
end

local loading = false

local function showLoadingScreen()
	loading = true
	-- limpa cartao do key
	for _, obj in ipairs(card:GetChildren()) do
		if obj:IsA("TextBox") or obj:IsA("TextButton") or obj:IsA("TextLabel") then
			obj.Visible = false
		end
	end

	local bigIcon = New("ImageLabel", {
		Image = "rbxassetid://" .. ICON_ID,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.new(0.5, -14, 0, 28),
		Size = UDim2.new(0, 28, 0, 28),
		ZIndex = 4,
	}, card)
	Corner(7, bigIcon)

	local lTitle = New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 20, 0, 72),
		Size = UDim2.new(1, -40, 0, 24),
		Text = "Loading script",
		TextSize = 16,
		TextColor3 = C.Text,
		ZIndex = 4,
	}, card)

	local lSub = New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 20, 0, 96),
		Size = UDim2.new(1, -40, 0, 16),
		Text = "Getting things ready...",
		TextSize = 11,
		TextColor3 = C.Dim,
		ZIndex = 4,
	}, card)

	local barBg = New("Frame", {
		BackgroundColor3 = C.Input,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 20, 0, 126),
		Size = UDim2.new(1, -40, 0, 8),
		ZIndex = 4,
	}, card)
	Corner(4, barBg)
	local barFill = New("Frame", {
		BackgroundColor3 = C.Accent,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 0, 1, 0),
		ZIndex = 5,
	}, barBg)
	Corner(4, barFill)

	local lStatus = New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 20, 0, 144),
		Size = UDim2.new(1, -40, 0, 16),
		Text = "Loading",
		TextSize = 10,
		TextColor3 = C.Dim,
		ZIndex = 4,
	}, card)

	local loadingWidgets = { bigIcon, lTitle, lSub, barBg, lStatus }

	Tween(barFill, {Size = UDim2.new(1, 0, 1, 0)}, LOAD_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
	Tween(bigIcon, {Rotation = 360}, LOAD_TIME, Enum.EasingStyle.Linear)

	task.delay(LOAD_TIME + 0.25, function()
		lStatus.Text = "Starting Night Menu..."
		task.wait(0.25)

		-- Carrega o Night Menu pelo URL
		local loaderErr = nil
		pcall(function()
			local loader = loadstring or load
			local okHttp, src = pcall(game.HttpGet, game, SCRIPT_URL)
			if not okHttp or not src or src == "" or not loader then
				loaderErr = "Falha ao carregar o menu: " .. tostring(src)
				return
			end
			local fn, compileErr = loader(src)
			if not fn then
				loaderErr = "Erro ao compilar menu: " .. tostring(compileErr)
				return
			end
			local okRun, runErr = pcall(fn)
			if not okRun then loaderErr = tostring(runErr) end
		end)

		-- Confirma que o menu realmente abriu (key aceite) antes de fechar o loader
		local confirmed = false
		for _ = 1, 80 do
			task.wait(0.15)
			local okCheck, found = pcall(function()
				local cg = game:GetService("CoreGui")
				if cg:FindFirstChild("NightModMenu") then return true end
				local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
				if pg and pg:FindFirstChild("NightModMenu") then return true end
				for _, obj in ipairs(cg:GetChildren()) do
					if obj:IsA("ScreenGui") and obj ~= gui and tostring(obj.Name):find("Night") then return true end
				end
				if _G.nightMenuUnloaded == false then return true end
				return false
			end)
			if okCheck and found then
				confirmed = true
				break
			end
		end

		if confirmed then
			pcall(function() gui:Destroy() end)
		else
			-- Key recusada: volta ao painel de key para tentar de novo
			for _, w in ipairs(loadingWidgets) do
				if w and w.Parent then w.Visible = false end
			end
			for _, obj in ipairs(card:GetChildren()) do
				if obj:IsA("TextBox") or obj:IsA("TextButton") or obj:IsA("TextLabel") then
					local isLoadingWidget = false
					for _, w in ipairs(loadingWidgets) do
						if w == obj then isLoadingWidget = true break end
					end
					if not isLoadingWidget then obj.Visible = true end
				end
			end
			loading = false
			if loaderErr then
				setStatus(loaderErr:sub(1, 70), Color3.fromRGB(255, 120, 120))
			else
				setStatus("Nao foi possivel abrir o menu. Ve o F9.", Color3.fromRGB(255, 120, 120))
			end
		end
	end)
end

checkBtn.MouseButton1Click:Connect(function()
	if loading then return end
	local key = tostring(keyBox.Text or ""):match("^%s*(.-)%s*$")
	if key == "" then
		setStatus("Escreve a key primeiro.", Color3.fromRGB(255, 120, 120))
		return
	end

	setStatus("A validar key...", C.Dim)
	local accepted, message = validateKeyWithApi(key)
	if not accepted then
		setStatus(message, Color3.fromRGB(255, 120, 120))
		Tween(keyBox, {BackgroundColor3 = Color3.fromRGB(90, 40, 45)}, 0.12)
		task.wait(0.18)
		Tween(keyBox, {BackgroundColor3 = C.Input}, 0.12)
		return
	end

	setStatus("Key correta!", Color3.fromRGB(120, 255, 150))
	pcall(function()
		if writefile then writefile("night_loader_key.txt", key) end
	end)
	task.wait(0.35)
	showLoadingScreen()
end)

